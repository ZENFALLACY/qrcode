# Copy to .env and fill in real values. Never commit .env.

PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/qr-menu

# Random secret for JWT signing (use a long random string in production)
JWT_SECRET=replace-with-long-random-secret

# Optional JWT lifetime (default 8h)
# JWT_EXPIRES_IN=8h

# Bcrypt hash of your admin/staff password — generate with:
#   npm run hash-password -- "YourStrongPassword"
# The hash below matches the DEMO password: changeme (rotate before any real use)
ADMIN_PASSWORD_HASH=$2b$10$COyt8qkreAc.ERx.ysNt6uivFLWrGOTgKNDIHnHa4Ee5LJGQ/mYwK

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_ORIGINS=http://localhost:3000
